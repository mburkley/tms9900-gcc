# Optimize for space.  Must be += here, not =: LIBGCC2_CFLAGS's base
# definition in libgcc/Makefile.in carries $(INHIBIT_LIBC_CFLAGS) and the
# standard include path/debug/libgcc flags, and a plain "=" here would
# silently wipe all of that out rather than just adding -Os to it.
LIBGCC2_CFLAGS += -Os
CRTSTUFF_T_CFLAGS = -Os

# Freestanding target: no libc, so libgcc2.c/tsystem.h must not pull in
# <stdio.h> and friends.
INHIBIT_LIBC_CFLAGS = -Dinhibit_libc

# Because POINTER_SIZE is only 16 here, in dwarf2out.cc, DWARF_ARANGES_PAD_SIZE
# is 0, thus a loop in output_aranges that checks
# (i < (unsigned) DWARF_ARANGES_PAD_SIZE) elicits a warning that the
# comparison is always false.
# We could say "-Werror -Wno-error=type-limits", alas, not all supported
# gcc bootstrap compilers support the latter option.
dwarf2out.o-warn = -Wno-error

LIB1ASMSRC    = tms9900/lib1funcs.asm
LIB1ASMFUNCS  = _divsi3 _udivsi3 _modsi3 _umodsi3

# No C++ exceptions or backtrace support on this freestanding target, and
# unwind-dw2.c currently trips a backend code-generation bug in its (large,
# struct-heavy) __frame_state_for() -- not worth chasing since this code
# would never run on real TI-99/4A hardware anyway.
LIB2ADDEH =

# Exclude 64-bit functions we don't need (yet)
LIB2FUNCS_EXCLUDE = _muldi3 _negdi2  _cmpdi2 _ucmpdi2 _lshrdi3 _ashldi3 \
_ashrdi3 _udivdi3 _divdi3 _umoddi3 _moddi3 _addvDI3 _subvDI3 \
__udivmoddi4

# ASCII <-> TI real (radix-100, TI-99/4A console ROM float format)
# conversion helpers for -mti99-float.
LIB2FUNCS_EXTRA = \
 $(srcdir)/config/tms9900/ftoa.cc \
 $(srcdir)/config/tms9900/atof.cc

# Tell make where to find headers for above
LIBGCC2_INCLUDES += -I$(srcdir)/config/tms9900
