+
+    if (REG_ATTRS(operands[1]))
+      printf("; off=%d\n", (int) REG_ATTRS(operands[1])->offset == -1);
+    else
+      printf ("; op1 no attrs\n");
+
+    if (REG_ATTRS(operands[1]) && REG_ATTRS(operands[1])->offset.to_constant() == 1)
+       output_asm_insn("swpb %0", operands);
