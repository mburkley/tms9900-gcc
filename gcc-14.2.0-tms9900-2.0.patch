+  /* Make denominator positive */
+testden:
+  xor  r3, r5
+  mov  r5, @-4(r10)
+  mov  r3, r3
+  jlt  negden
+  jmp  done
+negden:
+  inv  r3
+  neg  r4
+  jnc  done
+  inc  r3
+done:
+  b    *r11
+
