+/* All registers may be used as a base, except R0 or
+   pseudoregs when we are in strict mod */
+int tms9900_reg_ok_for_base(int strict, rtx reg)
+{
+  return(!strict ||
+         (REGNO(reg) !=0 && REGNO(reg) <= R15_REGNUM));
+}
